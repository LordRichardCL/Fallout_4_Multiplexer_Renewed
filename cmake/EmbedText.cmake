# Writes a C++ source that holds a text file as string pieces (each well under MSVC's literal limit).
#   fo4mx_embed_text(<input> <output.cpp> <symbol>)
# Defines `const char* const <symbol>Pieces[]` and `const size_t <symbol>PieceCount` in namespace fo4mx::embedded.
function(fo4mx_embed_text input output symbol)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${input})
    file(READ ${input} content)
    string(LENGTH "${content}" length)
    set(body "")
    set(count 0)
    set(offset 0)
    while(offset LESS length)
        string(SUBSTRING "${content}" ${offset} 4000 piece)
        string(APPEND body "    R\"fo4mx(${piece})fo4mx\",\n")
        math(EXPR offset "${offset} + 4000")
        math(EXPR count "${count} + 1")
    endwhile()
    set(text "// Generated from ${input} by cmake/EmbedText.cmake. Do not edit.\n#include <cstddef>\n\nnamespace fo4mx::embedded {\nextern const char* const ${symbol}Pieces[];\nextern const std::size_t ${symbol}PieceCount;\nconst char* const ${symbol}Pieces[] = {\n${body}    nullptr};\nconst std::size_t ${symbol}PieceCount = ${count};\n} // namespace fo4mx::embedded\n")
    file(WRITE ${output}.tmp "${text}")
    configure_file(${output}.tmp ${output} COPYONLY)
endfunction()
