# Writes the build cache's code fingerprints (cmake -P, run at build time by src/core/CMakeLists.txt).
#   -DSRC=<src/core>  -DLIST=<cmake/CacheComponents.cmake>  -DOUT=<header>  -DTOOLCHAIN=<compiler, version, type>
# For each component in the list: the SHA-256 of its files (path and content, in a fixed order) and the
# toolchain, so a change to any of them gives the component another version. Stops with an error when a listed
# file includes a project file that is neither listed nor a boundary (see cmake/CacheComponents.cmake).
cmake_minimum_required(VERSION 3.21)
include(${LIST})

function(expand out)
    set(files)
    foreach(pattern IN LISTS ARGN)
        if(pattern MATCHES "[*?]")
            file(GLOB matched RELATIVE ${SRC} ${SRC}/${pattern})
            list(APPEND files ${matched})
        elseif(EXISTS ${SRC}/${pattern})
            list(APPEND files ${pattern})
        else()
            message(FATAL_ERROR "Build cache components: ${pattern} does not exist (cmake/CacheComponents.cmake)")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES files)
    list(SORT files)
    set(${out} ${files} PARENT_SCOPE)
endfunction()

set(body "")
foreach(component IN LISTS FO4MX_CACHE_COMPONENTS)
    expand(files ${FO4MX_CACHE_COMMON} ${FO4MX_CACHE_${component}})
    if(NOT FO4MX_CACHE_${component}_NO_GUARD)
        set(boundaries ${FO4MX_CACHE_COMMON_BOUNDARIES} ${FO4MX_CACHE_${component}_BOUNDARIES})
        foreach(f IN LISTS files)
            if(NOT f MATCHES "\\.(cpp|hpp|inc)$")
                continue()
            endif()
            # A listed header whose functions live in a .cpp counts only with that .cpp.
            if(f MATCHES "^(.*)\\.hpp$" AND EXISTS ${SRC}/${CMAKE_MATCH_1}.cpp)
                list(FIND files ${CMAKE_MATCH_1}.cpp found)
                if(found EQUAL -1)
                    message(FATAL_ERROR "Build cache component ${component}: ${f} is listed without "
                                        "${CMAKE_MATCH_1}.cpp (cmake/CacheComponents.cmake)")
                endif()
            endif()
            file(STRINGS ${SRC}/${f} includes REGEX "^[ \t]*#[ \t]*include[ \t]+\"")
            get_filename_component(dir ${f} DIRECTORY)
            foreach(line IN LISTS includes)
                string(REGEX REPLACE "^[^\"]*\"([^\"]+)\".*$" "\\1" target "${line}")
                if(EXISTS ${SRC}/${target})
                    set(rel ${target})
                elseif(dir AND EXISTS ${SRC}/${dir}/${target})
                    set(rel ${dir}/${target})
                else()
                    continue() # outside the core (generated files, other libraries)
                endif()
                list(FIND files ${rel} inList)
                list(FIND boundaries ${rel} isBoundary)
                if(inList EQUAL -1 AND isBoundary EQUAL -1)
                    message(FATAL_ERROR "Build cache component ${component}: ${f} includes ${rel}, which is "
                                        "neither in the component nor a boundary. Add it to the component in "
                                        "cmake/CacheComponents.cmake when its code can change the cached result, "
                                        "or as a boundary (with the reason) when it cannot.")
                endif()
            endforeach()
        endforeach()
    endif()
    set(content "${TOOLCHAIN}\n")
    foreach(f IN LISTS files)
        file(SHA256 ${SRC}/${f} h)
        string(APPEND content "${f} ${h}\n")
    endforeach()
    string(SHA256 digest "${content}")
    string(SUBSTRING ${digest} 0 16 digest)
    list(LENGTH files n)
    string(TOLOWER ${component} name)
    string(APPEND body "inline constexpr const char* k_${name} = \"${digest}\"; // ${n} files\n")
endforeach()

set(text "// Generated by cmake/CacheFingerprint.cmake: code fingerprints of the build cache's components.\n#pragma once\n\nnamespace fo4mx::cachecode {\n${body}} // namespace fo4mx::cachecode\n")
# Written only when different, so unrelated changes do not rebuild what includes it.
if(EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if(NOT old STREQUAL text)
    file(WRITE ${OUT} "${text}")
endif()
